# Copy to .env.forensic-runtime.local and replace both CHANGE_ME values.
# The local file is ignored by Git. Use a URL-safe hexadecimal DB password.
FORENSIC_RUNTIME_DB_USER=forensic_runtime
FORENSIC_RUNTIME_DB_PASSWORD=CHANGE_ME
FORENSIC_RECORDS_API_KEY=CHANGE_ME
FORENSIC_RECORDS_TENANT_ID=default
NEXUSAI_AGENT_HISTORY_DATABASE_URL=postgresql://localrecall:CHANGE_ME@forensic-postgres:5432/localrecall?sslmode=disable
FORENSIC_RECORDS_PROXY_ACTOR_ID=nexusai-local-operator
FORENSIC_RECORDS_PROXY_ACTOR_ROLE=admin
FORENSIC_DEFAULT_JURISDICTION=PK
FORENSIC_DEFAULT_SOURCE_TIMEZONE=Asia/Karachi
FORENSIC_SYNTHESIS_MODEL=qwen_qwen3-4b-instruct-2507
NEXUSAI_LOCALAI_RUNTIME_IMAGE=nexusai/localai-forensic:phase3-runtime
NEXUSAI_FORENSIC_API_IMAGE=nexusai/forensic-records-api:phase3-runtime
NEXUSAI_FORENSIC_WORKER_IMAGE=nexusai/forensic-records-worker:phase3-runtime
FORENSIC_ANPR_ENABLED=false
FORENSIC_ANPR_ONNX_PROVIDERS=OpenVINOExecutionProvider,CPUExecutionProvider
FORENSIC_ANPR_MIN_DETECTION_CONFIDENCE=0.75
FORENSIC_VIDEO_MAX_SAMPLE_FRAMES=6
FORENSIC_VIDEO_SAMPLE_INTERVAL_SECONDS=5
FORENSIC_ASR_ENABLED=false
FORENSIC_ASR_ENDPOINT=http://api:8080/v1/audio/transcriptions
FORENSIC_ASR_MODEL=
FORENSIC_ASR_MAX_INPUT_BYTES=67108864
FORENSIC_ASR_TIMEOUT_SECONDS=300
# Point this at a read-only directory containing the existing open-image-models
# and fast-plate-ocr cache trees. No processor downloads models at runtime.
NEXUSAI_MEDIA_MODEL_DIR=./models/media
