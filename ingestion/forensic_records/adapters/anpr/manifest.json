{
  "contract_version": "forensics.adapter-manifest/v1",
  "id": "nexusai.adapter.anpr",
  "version": "1.2.0",
  "family_id": "anpr_vehicles",
  "status": "operational",
  "implementation": "ingestion.forensic_records.adapters.anpr",
  "normalization_version": "anpr-sighting-canonical/v1",
  "schema_profile_version": "anpr-source-mapping/v1",
  "schema_registry_version": "forensics.schema-registry/v1",
  "dynamic_attribute_contract": "forensics.dynamic-attribute/v1",
  "quality_contract": "forensics.structured-quality/v1",
  "time_policy_version": "forensics.time-policy/v1",
  "preserves_legacy_output": true,
  "formats": ["csv", "json", "jsonl", "ndjson", "parquet", "tsv", "xlsx"],
  "lifecycle": ["detect", "validate", "plan", "extract", "normalize", "derive", "persist", "index", "verify", "capabilities"],
  "operation_ids": [
    "anpr.detect_schema",
    "anpr.normalize_records",
    "anpr.sightings",
    "anpr.camera_sequence",
    "anpr.camera_activity",
    "anpr.co_travel",
    "anpr.route_timing",
    "anpr.plate_variants",
    "anpr.timeline"
  ],
  "required_accounting": ["total_rows", "accepted_rows", "duplicate_rows", "rejected_rows", "indexed_entities"],
  "required_provenance": ["tenant_id", "collection_id", "file_id", "batch_id", "evidence_id", "source_file", "row_number", "row_hash"],
  "localization": {
    "default_country_profile": "PK",
    "supported_timezone": "Asia/Karachi",
    "preserve_urdu": true,
    "preserve_plate_punctuation": true,
    "plate_matching_policy": "exact raw or exact NFKC alphanumeric search key",
    "province_policy": "preserve supplied jurisdiction; do not infer province from a plate"
  },
  "resource_profile": {
    "kind": "cpu_deterministic",
    "model_required": false,
    "bounded_query_seconds": 15,
    "default_result_limit": 20,
    "maximum_result_limit": 200
  },
  "limitations": [
    "No image OCR is performed by this structured-row adapter.",
    "Co-travel means same-camera temporal co-observation and is not proof of association.",
    "Route timing reports consecutive sightings and straight-line distance, not a reconstructed road route."
  ],
  "rollback": {
    "strategy": "compatibility wrapper",
    "target": "worker.normalize_anpr_details accepted Phase 4 behavior"
  }
}
