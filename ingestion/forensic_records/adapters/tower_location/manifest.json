{
  "contract_version": "forensics.adapter-manifest/v1",
  "id": "nexusai.adapter.tower_location",
  "version": "1.3.0",
  "family_id": "tower_location",
  "status": "operational",
  "implementation": "ingestion.forensic_records.adapters.tower_location",
  "normalization_version": "tower-location/v2",
  "schema_profile_version": "tower-source-mapping/v1",
  "schema_registry_version": "forensics.schema-registry/v1",
  "dynamic_attribute_contract": "forensics.dynamic-attribute/v1",
  "quality_contract": "forensics.structured-quality/v1",
  "time_policy_version": "forensics.time-policy/v1",
  "preserves_legacy_output": true,
  "formats": ["csv", "json", "jsonl", "ndjson", "geojson", "parquet", "tsv", "xlsx"],
  "lifecycle": ["detect", "validate", "plan", "extract", "normalize", "derive", "persist", "index", "verify", "capabilities"],
  "operation_ids": [
    "tower.detect_schema",
    "tower.normalize_records",
    "tower.site_lookup",
    "tower.reference_timeline",
    "tower.coordinate_audit",
    "tower.status_summary",
    "tower.alias_conflicts",
    "tower.cdr_join"
  ],
  "required_accounting": ["total_rows", "accepted_rows", "duplicate_rows", "rejected_rows", "indexed_entities"],
  "required_provenance": ["tenant_id", "collection_id", "file_id", "batch_id", "source_file", "row_number", "row_hash"],
  "location_policy": {
    "accepted_datums_without_transform": ["WGS84", "EPSG:4326"],
    "coordinate_uncertainty_required_for_unqualified_mapping": true,
    "rf_coverage_inference": false,
    "continuous_device_location_inference": false
  },
  "history_contract": {
    "history_key_roles": ["provider", "site", "sector"],
    "validity_bounds": "half_open_start_inclusive_end_exclusive",
    "overlap_disposition": "visible_review_required",
    "coordinate_datum_preserved": true,
    "uncertainty_preserved": true,
    "missing_bounds_inferred": false
  },
  "localization": {
    "default_country_profile": "PK",
    "supported_timezone": "Asia/Karachi",
    "provider_alias_key": "Unicode NFKC casefold alphanumeric",
    "preserve_urdu": true,
    "silent_transliteration": false
  },
  "resource_profile": {
    "kind": "cpu_deterministic",
    "model_required": false,
    "bounded_query_seconds": 15,
    "default_result_limit": 20,
    "maximum_result_limit": 100
  },
  "rollback": {
    "strategy": "compatibility wrapper",
    "target": "worker.normalize_tower_details accepted Phase 2 behavior"
  }
}
