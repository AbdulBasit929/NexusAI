{
  "schema": "nexusai.layout/v1",
  "layout_id": "call-ab-9-demo",
  "layout_version": 1,
  "status": "draft",
  "family": "communications",
  "dataset_kind": "target_cdr",
  "label": "Call records, 9 columns: caller and callee (a synthetic test fixture of the runtime acceptance collection; the subscriber is the caller on an originating call and the callee on a terminating one)",
  "operator_label": null,
  "container": {
    "kinds": [
      "tsv",
      "csv"
    ],
    "encoding": "utf-8",
    "delimiter": "\t",
    "sheet": "first",
    "header_row": {
      "mode": "fixed",
      "index": 0
    }
  },
  "header": {
    "columns": [
      {
        "name": "a_number"
      },
      {
        "name": "b_number"
      },
      {
        "name": "timestamp"
      },
      {
        "name": "call_end_time"
      },
      {
        "name": "direction"
      },
      {
        "name": "call_type"
      },
      {
        "name": "imei"
      },
      {
        "name": "imsi"
      },
      {
        "name": "cell_id"
      }
    ],
    "required": [
      "a_number",
      "b_number",
      "timestamp",
      "direction"
    ],
    "min_score": 0.9
  },
  "null_tokens": {},
  "confirmation": {
    "headers": "read_from_the_project_own_test_fixture_files_2026-10-21",
    "semantics_confirmed": false,
    "unconfirmed": [
      {
        "id": "source-time-zone",
        "what": "No file states a time zone. The zone is a job decision, never a property of the layout.",
        "affects": [
          "time"
        ]
      },
      {
        "id": "operator",
        "what": "The file is one of the project's own synthetic test fixtures and names no operator.",
        "affects": [
          "operator_label"
        ]
      },
      {
        "id": "originating-terminating",
        "what": "ORIGINATING and TERMINATING are read as outgoing and incoming from the subscriber's side; the files are the project's own test data.",
        "affects": [
          "enums.direction",
          "fields.a"
        ]
      }
    ],
    "settled": []
  },
  "fields": {
    "a": {
      "by_direction": {
        "outgoing": "a_number",
        "incoming": "b_number"
      }
    },
    "b": {
      "by_direction": {
        "outgoing": "b_number",
        "incoming": "a_number"
      }
    },
    "imsi": "imsi",
    "imei": "imei"
  },
  "time": {
    "columns": {
      "start": "timestamp",
      "end": "call_end_time"
    },
    "formats": [
      "iso_naive"
    ],
    "date_order": "YMD",
    "source_tz": null,
    "tz_basis": "unknown"
  },
  "duration": {
    "mode": "from_times"
  },
  "enums": [
    {
      "column": "direction",
      "confirmed": false,
      "map": {
        "ORIGINATING": {
          "direction": "outgoing"
        },
        "TERMINATING": {
          "direction": "incoming"
        }
      }
    },
    {
      "column": "call_type",
      "confirmed": true,
      "map": {
        "VOICE": {
          "event_type": "voice"
        }
      }
    }
  ],
  "cell": {
    "ci": "cell_id",
    "plmn": null
  },
  "quirks": [
    "The file has no subscriber column: a_number is the caller and b_number the callee, so the subscriber (a) is a_number on an originating call and b_number on a terminating one, and the other party is the other column",
    "Numbers are written with a leading 00 (international form)",
    "The cell identity is a site name such as LHR-001, kept as stated and partial"
  ],
  "golden": {
    "rows": 48,
    "hints": {
      "subject_form": "e164_12",
      "party_b_forms": [
        "international_00",
        "e164_12"
      ],
      "imei_digits": 15,
      "cell_style": "digits8"
    },
    "columns": {}
  }
}
