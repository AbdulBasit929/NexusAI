          "header",
          "time",
          "enums"
        ]
      },
      {
        "id": "source-time-zone",
        "what": "No file states a time zone. The zone is a job decision (time_basis assumed_by_profile or confirmed_by_analyst), never a property of the layout; without one, a date is kept as text in raw_payload_redacted and activated_at stays empty.",
        "affects": [
          "time"
        ]
      },
      {
        "id": "status-words",
        "what": "Whether Blocked, Barred, Inactive, Closed, Terminated and Disconnected mean what they are mapped to is not stated; they are flagged enum_unconfirmed:status.",
