  "quirks": [
    "A registration has no event time: it is valid from its activation to its deactivation; a row without dates is kept and its validity is open",
    "The name, the national ID number and the address are recognised, counted (a flag per column) and DROPPED; the stored copy of the row holds only the declared registration columns",
    "A statement from a row is 'registered per this source', never 'owned by' or 'is'",
    "A number written as 03xx, +92, 0092 or 92 is one number (92 + ten digits)"
  ],
  "confirmation": {
    "headers": "designed_2026-10-28_generic_subscriber_export_not_read_from_a_real_file",
