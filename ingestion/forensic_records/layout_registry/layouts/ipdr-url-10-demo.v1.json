{
  "schema": "nexusai.layout/v1",
  "layout_id": "ipdr-url-10-demo",
  "layout_version": 1,
  "status": "draft",
  "family": "internet",
  "dataset_kind": "ipdr",
  "label": "Internet records, 10 columns: one instant, addresses, domain and URL, subscriber, cell, volumes up and down (a synthetic test fixture of the records-demo collection)",
  "operator_label": null,
  "container": {
    "kinds": [
      "csv"
    ],
    "encoding": "utf-8",
    "delimiter": ",",
