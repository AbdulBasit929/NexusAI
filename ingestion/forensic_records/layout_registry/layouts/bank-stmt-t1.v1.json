  "quirks": [
    "A statement line has a debit or a credit, never both; the amount is positive and the direction says which way it went",
    "A date without a time of day (dd/mm/yyyy) is kept at local midnight and marked time_precision date: a question about minutes never reads it",
    "The narration and the counterparty name are the source's own text: stored with the row, kept out of the analyst views",
    "The balance column is checked row by row (file order): a row that does not follow from the one before it is flagged balance_break and kept"
  ],
  "confirmation": {
    "headers": "designed_2026-10-28_generic_bank_statement_export_not_read_from_a_real_file",
    "semantics_confirmed": false,
    "unconfirmed": [
      {
        "id": "real-sample",
        "what": "No real bank statement export has been read against this layout. It is a generic draft: the header names, the date formats and the channel words are designed, not observed. Promotion needs a real sample read in the vault (counts and booleans only) and the owner's confirmation.",
        "affects": [
          "header",
          "time",
          "enums"
        ]
      },
      {
        "id": "source-time-zone",
        "what": "No file states a time zone. The zone is a job decision (time_basis assumed_by_profile or confirmed_by_analyst), never a property of the layout.",
        "affects": [
          "time"
        ]
      },
      {
        "id": "date-order",
        "what": "A date written dd/mm/yyyy is read day first only when the job says so (date_order DMY); an ISO date-only text is not read by the time parser, a statement with date-only ISO dates needs its own layout.",
        "affects": [
          "time"
        ]
      }
    ],
    "settled": []
  },
