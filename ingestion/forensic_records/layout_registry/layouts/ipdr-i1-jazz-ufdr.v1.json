    {
      "id": "basic-information",
      "kind": "key_value_csv",
      "file_name_pattern": "^Basic Information.*\\.csv$",
      "carries": [
        "query criteria (a number or a NAT source address)",
        "time range",
        "shown and total record counts"
      ],
      "parsed_in_v1": false
    }
  ],
  "quirks": [
    "Two address spaces: UE IP is private, Public IP is after address translation, with one public port per row",
    "NAT End Time is empty on 40 to 60% of rows",
    "ECGI, SAI and CGI are alternative cell identities (ECGI mostly)",
    "Some files are queried by NAT source address, not by number",
    "IMEISV has 16 digits (15 on some rows)"
  ],
  "confirmation": {
    "headers": "confirmed_against_real_sample_structure_2026-10-12",
    "semantics_confirmed": false,
    "unconfirmed": [
      {
        "id": "source-time-zone",
        "what": "No file states a time zone. The zone is a job decision (time_basis assumed_by_profile or confirmed_by_analyst), never a property of the layout.",
        "affects": [
          "time"
        ]
      },
      {
        "id": "operator",
        "what": "The operator that produced the layout is not stated in the files; confirm against the export documentation before using a label.",
        "affects": [
          "operator_label"
        ]
      },
      {
        "id": "cell-identity",
        "what": "ECGI structure (PLMN plus a hexadecimal cell identity) is a reading of the masks; the value is kept as cell_raw and not parsed.",
        "affects": [
          "cell"
        ]
      },
      {
        "id": "rat-codes",
        "what": "RAT type is a numeric code; its names are not in the file.",
        "affects": [
          "fields.rat"
        ]
      },
      {
        "id": "sub-protocol",
        "what": "EGN Sub Protocol Type mixes names and numeric codes; numeric codes are not assumed to be IANA protocol numbers.",
        "affects": [
          "fields.protocol"
        ]
      },
      {
        "id": "companion",
        "what": "The Basic Information file's labels are not recorded here; shown and total record counts are not yet extracted.",
        "affects": [
          "companions"
        ]
      }
    ],
    "settled": [
      {
        "id": "header-list",
        "how": "tools/real_data/confirm_layout.py passed against a shareable structure report of a real sample file (header names and order, time formats, vocabulary labels)",
        "on": "2026-10-12"
      }
    ]
  },
  "golden": {
    "rows": 48,
    "hints": {
      "imei_digits": 16,
      "port_style": "public_single"
    },
    "columns": {
      "Charging Characteristics": "choice:0100|0800",
      "SAI": "empty",
      "CGI": "empty",
      "Data Source": "choice:Source A|Source B",
      "ECGI": "choice:0010100000001|0010100000002|0010100000003",
      "RAT type": "choice:6",
      "APN": "choice:internet.example|ims.example"
    }
  }
