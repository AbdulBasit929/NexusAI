{
  "schema": "nexusai.layout/v1",
  "layout_id": "call-c3-ufone-style",
  "layout_version": 1,
  "status": "draft",
  "family": "communications",
  "dataset_kind": "target_cdr",
  "label": "Call records, 17 columns (Ufone-style, with Service Provider and Cell Sector)",
  "operator_label": null,
  "container": {
    "kinds": [
      "xlsx"
    ],
    "sheet": "first",
    "header_row": {
      "mode": "scan",
      "max_rows": 8
    }
  },
  "header": {
    "columns": [
      {
        "name": "IMEI"
      },
      {
        "name": "IMSI"
      },
      {
        "name": "A Number"
      },
      {
        "name": "B Number"
      },
      {
        "name": "Start Time"
      },
      {
        "name": "End Time"
      },
      {
        "name": "Service Provider"
      },
      {
        "name": "Type"
      },
      {
        "name": "Direction"
      },
      {
        "name": "Location"
      },
      {
        "name": "Cell Id"
      },
      {
        "name": "Cell Sector"
      },
      {
        "name": "Latitude"
      },
      {
        "name": "Longitude"
      },
      {
        "name": "Duration"
      },
      {
        "name": "Description"
      },
      {
        "name": "MACAddress"
      }
    ],
    "required": [
      "IMEI",
      "IMSI",
      "A Number",
      "B Number",
      "Start Time",
      "End Time",
      "Service Provider",
      "Type",
      "Direction",
      "Cell Id",
      "Duration"
    ],
    "min_score": 0.9
  },
  "fields": {
    "a": "A Number",
    "b": "B Number",
    "imsi": "IMSI",
    "imei": "IMEI",
    "location_text": "Location",
    "lat": "Latitude",
    "lon": "Longitude",
    "peer_operator": {
      "column": "Service Provider",
      "operators": [
        "ufone",
        "zong",
        "mobilink",
        "telenor",
        "warid"
      ]
    }
  },
  "time": {
    "columns": {
      "start": "Start Time",
      "end": "End Time"
    },
    "formats": [
      "excel_serial_1900",
      "iso_naive"
    ],
    "date_order": null,
    "source_tz": null,
    "tz_basis": "unknown"
  },
  "duration": {
    "mode": "column_seconds",
    "column": "Duration"
  },
  "enums": [
    {
      "column": "Type",
      "confirmed": true,
      "map": {
        "SMS": {
          "event_type": "sms"
        },
        "VOICE": {
          "event_type": "voice"
        }
      }
    },
    {
      "column": "Direction",
      "confirmed": true,
      "map": {
        "INCOMING": {
          "direction": "incoming"
        },
        "OUTGOING": {
          "direction": "outgoing"
        }
      }
    }
  ],
  "cell": {
    "ci": "Cell Id",
    "plmn": null
  },
  "noise_columns": [
    "Description",
    "MACAddress"
  ],
  "preamble": {
    "kind": "key_value_rows",
    "rows": 3
  },
  "quirks": [
    "Service Provider is the peer network; its casing varies (ufone, UFONE) and it also holds labels (INTERNET, SHORTCODE, UNKNOWN, INTERNATIONAL, NEW_NETWORK) that are not operators",
    "Cell Id is a 10-digit identity or an alphanumeric code; Cell Sector may hold '+'",
    "End Time is empty on about 5% of rows"
  ],
  "confirmation": {
    "headers": "confirmed_against_real_sample_structure_2026-10-12",
    "semantics_confirmed": false,
    "unconfirmed": [
      {
        "id": "source-time-zone",
        "what": "No file states a time zone. The zone is a job decision (time_basis assumed_by_profile or confirmed_by_analyst), never a property of the layout.",
        "affects": [
          "time"
        ]
      },
      {
        "id": "operator",
        "what": "The operator that produced the layout is not stated in the files; confirm against the export documentation before using a label.",
        "affects": [
          "operator_label"
        ]
      },
      {
        "id": "duration-unit",
        "what": "The duration unit is read from the value range, not from documentation.",
        "proposed": "seconds",
        "affects": [
          "duration"
        ]
      },
      {
        "id": "noise-columns",
        "what": "Description and MACAddress carry network-adapter text on a few rows (not call data); they are kept in the raw payload and flagged, never mapped.",
        "affects": [
          "noise_columns"
        ]
      },
      {
        "id": "preamble",
        "what": "Preamble lines differ between exports of this layout (a file and its 'updated' twin); the header row is found by scanning.",
        "affects": [
          "container"
        ]
      },
      {
        "id": "cell-id",
        "what": "Cell Id has no area code column; its structure is unknown.",
        "affects": [
          "cell"
        ]
      }
    ],
    "settled": [
      {
        "id": "header-list",
        "how": "tools/real_data/confirm_layout.py passed against a shareable structure report of a real sample file (header names and order, time formats, vocabulary labels)",
        "on": "2026-10-12"
      }
    ]
  },
  "golden": {
    "rows": 48,
    "preamble": [
      [
        "Subscriber",
        "{subject10}"
      ],
      [
        "Report",
        "Synthetic call detail"
      ],
      [
        "Reference",
        "{ref13}"
      ]
    ],
    "hints": {
      "subject_form": "e164_12",
      "party_b_forms": [
        "e164_12",
        "short_code",
        "sender_id",
        "service_label",
        "local_10"
      ],
      "imei_digits": 15,
      "serial_decimals": 12,
      "cell_style": "digits10",
      "coordinate_decimals": 15
    },
    "columns": {
      "Service Provider": "choice:ufone|UFONE|zong|telenor|INTERNET|SHORTCODE",
      "Cell Sector": "int:0-3",
      "Description": "noise_text",
      "MACAddress": "noise_mac"
    },
    "blank_columns": 11
  }
}
