{
  "schema": "nexusai.layout/v1",
  "layout_id": "call-c2-strt-tm",
  "layout_version": 1,
  "status": "draft",
  "family": "communications",
  "dataset_kind": "target_cdr",
  "label": "Call records, 14 columns with STRT_TM and split minutes and seconds",
  "operator_label": null,
  "container": {
    "kinds": [
      "xlsx"
    ],
    "sheet": "first",
    "header_row": {
      "mode": "scan",
      "max_rows": 8
    }
  },
  "header": {
    "columns": [
      {
        "name": "CALL_TYPE"
      },
      {
        "name": "MSISDN"
      },
      {
        "name": "STRT_TM"
      },
      {
        "name": "BNUMBER"
      },
      {
        "name": "MINS"
      },
      {
        "name": "SECS"
      },
      {
        "name": "LAC_ID"
      },
      {
        "name": "CELL_ID"
      },
      {
        "name": "IMEI"
      },
      {
        "name": "SITE_ADDRESS"
      },
      {
        "name": "LNG"
      },
      {
        "name": "LAT"
      },
      {
        "name": "Description"
      },
      {
        "name": "MACAddress"
      }
    ],
    "required": [
      "CALL_TYPE",
      "MSISDN",
      "STRT_TM",
      "BNUMBER",
      "MINS",
      "SECS",
      "LAC_ID",
      "CELL_ID",
      "IMEI"
    ],
    "min_score": 0.9
  },
  "fields": {
    "a": "MSISDN",
    "b": "BNUMBER",
    "imei": "IMEI",
    "location_text": "SITE_ADDRESS",
    "lat": "LAT",
    "lon": "LNG"
  },
  "time": {
    "columns": {
      "start": "STRT_TM"
    },
    "formats": [
      "slash_24h_seconds",
      "iso_naive"
    ],
    "date_order": null,
    "source_tz": null,
    "tz_basis": "unknown"
  },
  "duration": {
    "mode": "minutes_seconds",
    "minutes": "MINS",
    "seconds": "SECS"
  },
  "enums": [
    {
      "column": "CALL_TYPE",
      "confirmed": true,
      "map": {
        "Call - Incoming": {
          "event_type": "voice",
          "direction": "incoming"
        },
        "Call - Outgoing": {
          "event_type": "voice",
          "direction": "outgoing"
        }
      }
    }
  ],
  "cell": {
    "lac_tac": "LAC_ID",
    "ci": "CELL_ID",
    "plmn": null
  },
  "noise_columns": [
    "Description",
    "MACAddress"
  ],
  "preamble": {
    "kind": "key_value_rows",
    "rows": 3,
    "note": "three lines before the header carry the subscriber's number and an identity number: never copied into goldens or logs"
  },
  "quirks": [
    "No IMSI and no end time",
    "Duration is split into minutes and seconds",
    "BNUMBER is 10-digit, 11-digit or 14-digit",
    "An 'updated' twin of the same export has no preamble and slightly fewer rows"
  ],
  "confirmation": {
    "headers": "structure_only_inspection_2026-10-12",
    "semantics_confirmed": false,
    "unconfirmed": [
      {
        "id": "header-list",
        "what": "The header list was read by a structure-only inspection; confirm it against a shareable profile report of the real file (tools/real_data/confirm_layout.py).",
        "affects": [
          "header"
        ]
      },
      {
        "id": "source-time-zone",
        "what": "No file states a time zone. The zone is a job decision (time_basis assumed_by_profile or confirmed_by_analyst), never a property of the layout.",
        "affects": [
          "time"
        ]
      },
      {
        "id": "operator",
        "what": "The operator that produced the layout is not stated in the files; confirm against the export documentation before using a label.",
        "affects": [
          "operator_label"
        ]
      },
      {
        "id": "slash-date-order",
        "what": "Day-first or month-first is not settled by the masks; confirm with the profile report (day_month_order) or the operator's documentation.",
        "proposed": "DMY for dd/mm/yyyy exports; settle before activating",
        "affects": [
          "time"
        ]
      },
      {
        "id": "noise-columns",
        "what": "Description and MACAddress carry network-adapter text on a few rows (not call data); they are kept in the raw payload and flagged, never mapped.",
        "affects": [
          "noise_columns"
        ]
      },
      {
        "id": "preamble",
        "what": "Preamble lines differ between exports of this layout (a file and its 'updated' twin); the header row is found by scanning.",
        "affects": [
          "container"
        ]
      },
      {
        "id": "event-types",
        "what": "Only 'Call - Incoming' and 'Call - Outgoing' were seen; other labels (for example SMS) are unmapped and flagged until observed.",
        "affects": [
          "enums"
        ]
      }
    ]
  },
  "golden": {
    "rows": 48,
    "preamble": [
      [
        "Subscriber Number",
        "{subject10}"
      ],
      [
        "Report",
        "Synthetic call detail"
      ],
      [
        "Reference",
        "{ref13}"
      ]
    ],
    "hints": {
      "subject_form": "e164_12",
      "party_b_forms": [
        "local_10",
        "local_11",
        "international_00"
      ],
      "imei_digits": 15,
      "cell_style": "digits5",
      "lac_digits": 5,
      "coordinate_decimals": 5,
      "date_order": "DMY"
    },
    "columns": {
      "Description": "noise_text",
      "MACAddress": "noise_mac"
    }
  }
}
