  "cell": {
    "lac_tac": "lac/tac",
    "ci": "cell/eci",
    "plmn": null
  },
  "protocol_numbers": "iana",
  "quirks": [
    "Saved with an .xls extension but the content is SpreadsheetML (XML)",
    "A public port range per row",
    "Protocol is a numeric code (1 or 2 digits)",
    "One timestamp per row (no end time)",
    "host and url are filled on about 3% of rows"
  ],
  "confirmation": {
    "headers": "structure_only_inspection_2026-10-12",
    "semantics_confirmed": false,
    "unconfirmed": [
      {
        "id": "header-list",
        "what": "The header list was read by a structure-only inspection; confirm it against a shareable profile report of the real file (tools/real_data/confirm_layout.py).",
        "affects": [
          "header"
        ]
      },
      {
        "id": "source-time-zone",
        "what": "No file states a time zone. The zone is a job decision (time_basis assumed_by_profile or confirmed_by_analyst), never a property of the layout.",
        "affects": [
          "time"
        ]
      },
      {
        "id": "protocol-codes",
        "what": "Numeric protocol codes are read as IANA protocol numbers (6 tcp, 17 udp, 1 icmp); other values are flagged.",
        "proposed": "iana",
        "affects": [
          "protocol_numbers"
        ]
      },
      {
        "id": "cell-columns",
        "what": "cell/eci (5 or 8 digits) is read as the cell identity and lac/tac (5 digits) as the area code.",
        "affects": [
          "cell"
        ]
      },
      {
        "id": "src-dst",
        "what": "src_address is read as the subscriber side and dst_address as the server side.",
        "affects": [
          "fields.ue_ip",
          "fields.server_ip"
        ]
      }
    ]
  },
  "golden": {
    "rows": 48,
    "hints": {
      "imei_digits": 15,
      "cell_style": "digits8",
      "lac_digits": 5,
      "port_style": "public_range"
    },
    "columns": {
      "app": "choice:app_a|app_b|app_c",
      "host": "mostly_empty_host",
      "url": "mostly_empty_path"
    }
  }
