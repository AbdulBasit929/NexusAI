    "msisdn": "msisdn",
    "imsi": "imsi",
    "imei": "imei",
    "ue_ip": "src_address",
    "ue_port": "src_port",
    "public_ip": "Public IP",
    "public_port_from": "Public Port Start",
    "public_port_to": "Public Port End",
    "server_ip": "dst_address",
    "server_port": "dst_port",
    "protocol": "protocol",
