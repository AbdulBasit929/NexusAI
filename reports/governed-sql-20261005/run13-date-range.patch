+// "between 2025 and 2026" is a range of years, a time condition, not a quantity.
+var govSQLRxBetweenYear = regexp.MustCompile(`(?i)\bbetween\s+(?:19|20)\d{2}\b`)
+
 var govSQLStopWords = func() map[string]bool {
