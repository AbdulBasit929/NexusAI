+		golangci-lint run ${lint_base:+--new-from-merge-base=$lint_base} ./api/forensic_records/
+		go vet ./api/forensic_records/
+		GOOS=linux GOARCH=amd64 go vet ./api/forensic_records/
+		go test -count=1 ./api/forensic_records/
+	else
+		echo "pre-commit ▶ golangci-lint (make lint${lint_base:+, new-from $lint_base})"
+		make lint LINT_NEW_FROM="$lint_base"
 
